# OpenAI-Schlüssel (nie ins Repo einchecken)
OPENAI_API_KEY=sk-...
# Planer-Modell: gpt-6.2-sol (Standard), gpt-6.1-sol, gpt-6.2-astra (stärkstes, teurer), gpt-6.1-terra (günstigstes)
OPENAI_MODEL=gpt-6.2-sol
# Optional: stärkeres Modell nur für den CAD-Code neuer Teile
OPENAI_CAD_MODEL=gpt-6.2-astra
# Denkaufwand beim Ändern: low | medium | high
OPENAI_EFFORT=low
# Referenzbild: low für schnelle Planung, high für feinere Bilddetails
OPENAI_IMAGE_DETAIL=low
# Modellansichten aus dem Canvas (4 Ansichten + 2 nummerierte): low (günstig) oder high
OPENAI_VIEW_DETAIL=low
# Schutzgrenze: höchstens so viele neue Teile pro Auftrag
MAX_NEUE_TEILE=12
# KI-Aufträge pro Client und Minute (0 = aus)
RATE_LIMIT_PER_MIN=30
# Ohne Schlüssel testen: LLM_MODE=mock
# Einmal-Sitzungen der Hauptapp nach so vielen Minuten löschen
ADHOC_TTL_MIN=60
